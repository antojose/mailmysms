<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <include layout="@layout/header_brand_slim" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-12dp"
            android:textSize="12sp"
            android:alpha="0.6" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="17sp"
            android:textStyle="bold"
            android:text="Why MailMySMS exists" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="15sp"
            android:lineSpacingExtra="6dp"
            android:text="Your messages and call history are personal. Backing them up shouldn’t mean handing them over to yet another service or trusting an unfamiliar server with your data." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="15sp"
            android:lineSpacingExtra="6dp"
            android:text="MailMySMS takes a simpler approach. It connects directly to your own email account and saves your messages and call history there over IMAP. No intermediary backup servers, no separate cloud account to sign up for. Just your phone and your mailbox." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="15sp"
            android:lineSpacingExtra="6dp"
            android:text="It started as a personal itch — I wanted a simple way to keep my SMS and call history safely archived in my own inbox. One thing led to another, and now it can back up years of messages, export them locally, and handle RCS messages where Android makes them accessible." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="15sp"
            android:lineSpacingExtra="6dp"
            android:text="@string/about_tagline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="15sp"
            android:lineSpacingExtra="6dp"
            android:text="MailMySMS is open source, so anyone can inspect the code, understand how it works, and help make it better." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="15sp"
            android:lineSpacingExtra="6dp"
            android:text="Built and maintained by one person in spare time, mostly out of curiosity and the joy of making useful little things." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/githubButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="View source on GitHub" />

        <TextView
            android:id="@+id/privacyPolicyLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:textSize="13sp"
            android:alpha="0.75"
            android:text="Privacy policy" />

        <!-- Flexible spacer: on tall screens this absorbs the leftover height so the
             feedback/coffee asks below settle toward the bottom as a lightweight footer,
             without leaving dead space below the Coffee button; on short screens it
             collapses to 0dp and the page scrolls normally. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:text="Finding MailMySMS useful?" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:alpha="0.75"
            android:text="The good, the bad, the ugly — I'd love to hear it all. Your feedback helps make MailMySMS better." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/feedbackButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Send feedback" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:text="Want to keep the little improvements coming?" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:alpha="0.75"
            android:text="If MailMySMS makes your life a little easier, you can always fuel the next round of tinkering with a coffee. ☕" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/coffeeButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Buy me a coffee ☕" />

    </LinearLayout>
</ScrollView>
