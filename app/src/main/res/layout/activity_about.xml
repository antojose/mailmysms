<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <include layout="@layout/header_brand_slim" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-12dp"
            android:textSize="12sp"
            android:alpha="0.6" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="17sp"
            android:textStyle="bold"
            android:text="Why MailMySMS exists" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="4dp"
            android:text="Your texts and call log are some of the most personal data on your phone — and most “backup” apps want you to trust a company you’ve never heard of with all of it, routed through servers you can’t see." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"
            android:text="MailMySMS skips the middleman. It connects straight to your own mailbox over IMAP and writes each message there directly — nothing passes through a server we run, because we don’t run one. No backup cloud to sign up for. Just your own mailbox." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"
            android:text="It started as a personal itch: a simple way to keep SMS and call history safely archived without handing it to a stranger’s cloud. It’s grown since — bulk backup for years of existing history, RCS support where your phone stores it alongside SMS/MMS, local exports — but the core idea hasn’t changed: your phone, your mailbox, nothing in between." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"
            android:text="The code is open source, so you — or anyone — can check exactly what it does before trusting it with anything." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"
            android:text="Built and maintained by one person, in spare time. If something’s broken or missing, say so — genuine feedback, good or bad, is what keeps this useful." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/githubButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="View source on GitHub" />

        <!-- Flexible spacer: on tall screens this absorbs the leftover height so the
             feedback/coffee asks below settle toward the bottom as a lightweight footer,
             without leaving dead space below the Coffee button; on short screens it
             collapses to 0dp and the page scrolls normally. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/feedbackButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Send feedback (GitHub Issues)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/feedbackEmailButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Send feedback (Email)" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:text="Want to keep the little improvements coming?" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:alpha="0.75"
            android:text="If MailMySMS makes your life a little easier, you can always fuel the next round of tinkering with a coffee. ☕" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/coffeeButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Buy me a coffee ☕" />

    </LinearLayout>
</ScrollView>
